/// A private ID file is stable for one dive and cannot enter any physical disk.
/datum/unit_test/netrun_dive_identity_snapshot_transport/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	var/obj/item/card/id/card = allocate(/obj/item/card/id)
	card.access = list(ACCESS_MEDICAL)
	TEST_ASSERT(scene.user.equip_to_slot_if_possible(uniform, ITEM_SLOT_ICLOTHING, disable_warning = TRUE), "The diver wears a real uniform")
	TEST_ASSERT(scene.user.equip_to_slot_if_possible(card, ITEM_SLOT_ID, disable_warning = TRUE), "The actual ID supplies entry credentials")
	scene.authorize()
	TEST_ASSERT(scene.implant.complete_dive(scene.target_node, scene.user), "The authorized neural entry succeeds")
	var/mob/camera/netrun_entity/entity = scene.implant.console.dive_ref?.resolve()
	var/datum/netrun_file/access/session_snapshot/file = entity.dive_link.identity_snapshot
	TEST_ASSERT(istype(file), "Entry creates a typed session credential file")
	TEST_ASSERT_EQUAL(entity.console.inventory.store_for(file), entity.console.inventory.session_store, "The file belongs to private session memory")
	TEST_ASSERT_NULL(scene.implant.console.find_local_file(file.uid), "The shared implant disk never receives the snapshot")
	TEST_ASSERT_NULL(file.access_for(scene.implant.console), "Another console cannot use the session's station ID rights")
	TEST_ASSERT_NULL(file.copy(), "The source file refuses authority-bearing copies")
	TEST_ASSERT(!scene.implant.console.inventory.local_store.insert(file, TRUE), "Even preload insertion cannot move the snapshot onto physical storage")
	var/obj/item/netrun_shard/shard = allocate(/obj/item/netrun_shard)
	TEST_ASSERT_NULL(entity.console.inventory.session_store.transfer_to(shard.file_store, file, TRUE), "Move cannot bypass the session restriction")
	TEST_ASSERT_NULL(entity.console.inventory.session_store.transfer_to(entity.console.inventory.local_store, file), "Copy cannot bypass the session restriction")
	TEST_ASSERT(file in entity.console.inventory.session_store.files, "Rejected transport leaves the live original intact")
	card.access = list(ACCESS_SECURITY)
	TEST_ASSERT(ACCESS_MEDICAL in entity.console.user_access(TRUE), "Editing the body's ID does not edit an existing dive")
	TEST_ASSERT(!(ACCESS_SECURITY in entity.console.user_access(TRUE)), "New body rights wait for another immersion")
	entity.console.access_session.grant_node(scene.target_node, NETRUN_ACCESS_ROOT)
	TEST_ASSERT(!entity.console.transfer_to_node(file.uid, scene.target_node, TRUE), "Native upload fails despite sufficient target ROOT")
	TEST_ASSERT_NULL(scene.target_node.file_store.find_file(file.uid), "Rejected upload leaves no authority on the remote node")
	var/list/entry = file.ui_entry()
	TEST_ASSERT(entry["session_bound"] && !entry["transferable"], "UI metadata describes the same enforced restriction")
	entity.return_to_body()
	TEST_ASSERT(QDELETED(file), "Voluntary return deletes the session credential source")
	TEST_ASSERT_NULL(scene.implant.console.find_local_file(file.uid), "Returning cannot persist the expired source in the implant")
	TEST_ASSERT(scene.implant.complete_dive(scene.target_node, scene.user), "A new dive starts with the body's current ID")
	entity = scene.implant.console.dive_ref?.resolve()
	TEST_ASSERT((ACCESS_SECURITY in entity.console.user_access(TRUE)) && !(ACCESS_MEDICAL in entity.console.user_access(TRUE)), "The next session captures a fresh independent identity")

/// Deletion is an explicit early revoke; ending the owning link expires its file.
/datum/unit_test/netrun_dive_identity_snapshot_revocation/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	var/obj/item/card/id/card = allocate(/obj/item/card/id)
	card.access = list(ACCESS_MEDICAL)
	TEST_ASSERT(scene.user.put_in_active_hand(card), "A real held ID is an entry credential source")
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.target_node)
	TEST_ASSERT(entity.dive_link.attach(scene.user, scene.target_node), "A body link owns its identity snapshot")
	var/datum/netrun_file/access/session_snapshot/file = entity.dive_link.identity_snapshot
	entity.console.access_cache = entity.console.user_access(TRUE)
	TEST_ASSERT(ACCESS_MEDICAL in entity.console.user_access(), "The source may participate in a pass-local access cache")
	TEST_ASSERT(entity.console.delete_local_file(file), "Deleting the private file is allowed")
	TEST_ASSERT_NULL(entity.console.access_cache, "Source deletion invalidates cached station credentials")
	TEST_ASSERT(!(ACCESS_MEDICAL in entity.console.user_access(TRUE)), "The still-worn body cannot silently recreate deleted session rights")
	TEST_ASSERT(entity.dive_link.attach(scene.user, scene.target_node), "A distinct new link may take a new snapshot")
	file = entity.dive_link.identity_snapshot
	qdel(entity.dive_link)
	TEST_ASSERT(QDELETED(file), "Destroying the owning session releases its credentials immediately")

/// Native breach results can be exported; ID access and residency cannot be minted.
/datum/unit_test/netrun_acquired_key_native_authority/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/source = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/recipient = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	source.console.operator = source
	TEST_ASSERT_NULL(source.console.export_acquired_key("residency.grants"), "Initial residency is not proof of a hack")
	source.console.access_session.node_access[scene.node_b.address] = NETRUN_ACCESS_ROOT
	source.console.access_session.network_access[scene.node_b.network.id] = NETRUN_ACCESS_GUEST
	TEST_ASSERT_NULL(source.console.export_acquired_key("unsigned.grants"), "Unsigned compatibility tables cannot mint proven access")
	source.console.access_session.revoke_all()
	TEST_ASSERT(source.console.store_file(netrun_daemon_file("autobreach")), "A real automatic hacking executable is required")
	TEST_ASSERT(source.console.start_breach("network", scene.node_b.network.id, TRUE), "The LAN uses the normal breach pipeline")
	var/datum/netrun_breach/automatic/breach = source.console.intrusion.breach
	breach.deadline = world.time
	breach.finish()
	TEST_ASSERT(source.console.start_breach("node", scene.node_b.address, TRUE), "The node uses an independent ordinary breach")
	breach = source.console.intrusion.breach
	breach.deadline = world.time
	breach.finish()
	TEST_ASSERT(source.console.store_file(new /datum/netrun_file/access("captain.access", list(ACCESS_CAPTAIN, ACCESS_NETWORK))), "Real station credentials may coexist with acquired access")
	var/datum/netrun_file/acquired_key/key = source.console.export_acquired_key("earned.grants")
	TEST_ASSERT_NOTNULL(key, "Completed native hacks can issue a portable key")
	TEST_ASSERT_EQUAL(length(key.node_grants), 1, "Only the genuinely cracked node appears")
	TEST_ASSERT_EQUAL(key.node_grants[scene.node_b.address], NETRUN_ACCESS_USER, "Autobreach exports USER without ID-based ROOT escalation")
	TEST_ASSERT_EQUAL(length(key.network_grants), 1, "The genuinely cracked gateway has its own scope")
	var/datum/netrun_file/acquired_key/copy = key.copy()
	TEST_ASSERT(copy.uid != key.uid && recipient.console.store_file(copy), "The recipient owns an independent ordinary key copy")
	TEST_ASSERT_EQUAL(recipient.console.node_level(scene.node_b), NETRUN_ACCESS_USER, "A real owned file grants its effective scoped rights")
	TEST_ASSERT_EQUAL(recipient.console.legit_node_level(scene.node_b), NETRUN_ACCESS_NONE, "Effective hacked access does not become legitimate ID authority")
	TEST_ASSERT_EQUAL(length(recipient.console.user_access(TRUE)), 0, "The key contains no station access list")
	var/obj/item/target = scene.node_b.parent
	target.req_access = list(ACCESS_CAPTAIN)
	TEST_ASSERT(!target.allowed(recipient), "Native allowed() never consumes acquired network grants")
	TEST_ASSERT_NULL(recipient.console.export_acquired_key("laundered.grants"), "Using a file does not permanently merge its rights into the session")
	TEST_ASSERT(recipient.console.delete_local_file(copy), "The actual source key can be deleted")
	TEST_ASSERT(recipient.console.node_level(scene.node_b) < NETRUN_ACCESS_USER, "Removing the last key revokes effective authority immediately")

/// Copies retain their original revocation stamps through firewall and domain changes.
/datum/unit_test/netrun_acquired_key_scope_revocation/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/source = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/recipient = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	source.console.access_session.grant_node(scene.node_b, NETRUN_ACCESS_USER, NETRUN_ACCESS_USER)
	source.console.access_session.grant_network(scene.node_b.network, NETRUN_ACCESS_GUEST, NETRUN_ACCESS_GUEST)
	var/datum/netrun_file/acquired_key/key = source.console.export_acquired_key("scoped.grants")
	var/datum/netrun_file/acquired_key/copy = key.copy()
	TEST_ASSERT(recipient.console.store_file(copy), "An earned scope has a transferable independent source")
	TEST_ASSERT_EQUAL(recipient.console.node_level(scene.node_b), NETRUN_ACCESS_USER, "The copied node grant begins valid")
	recipient.console.ui_node_levels = list()
	recipient.console.ui_node_levels[scene.node_b.address] = NETRUN_ACCESS_USER
	scene.node_b.raise_firewall()
	TEST_ASSERT(recipient.console.node_level(scene.node_b) < NETRUN_ACCESS_USER, "The firewall revokes imported scopes before cached authority can be reused")
	var/datum/netrun_file/acquired_key/after_firewall = copy.copy()
	TEST_ASSERT_EQUAL(after_firewall.node_level(scene.node_b), NETRUN_ACCESS_NONE, "Copying an invalidated key cannot refresh its epoch")
	qdel(after_firewall)
	source.console.access_session.process_events()
	source.console.access_session.grant_node(scene.node_b, NETRUN_ACCESS_USER, NETRUN_ACCESS_USER)
	var/datum/netrun_file/acquired_key/fresh = source.console.export_acquired_key("fresh.grants")
	var/datum/netrun_file/acquired_key/fresh_copy = fresh.copy()
	TEST_ASSERT(recipient.console.store_file(fresh_copy), "An actual reacquired scope can be issued again")
	TEST_ASSERT_EQUAL(fresh_copy.node_level(scene.node_b), NETRUN_ACCESS_USER, "The fresh generation is independently valid")
	scene.node_b.notify_changed(NETRUN_CHANGED_BINDING)
	TEST_ASSERT_EQUAL(fresh_copy.node_level(scene.node_b), NETRUN_ACCESS_NONE, "A changed binding invalidates the original node scope")
	var/datum/netrun_network/network = scene.node_b.network
	network.passcode = "rotated-test-passcode"
	TEST_ASSERT_EQUAL(copy.network_level(network), NETRUN_ACCESS_NONE, "A rotated LAN key invalidates exported gateway rights")
	TEST_ASSERT_NULL(source.console.export_acquired_key("rotated.grants"), "A stale direct session grant cannot be re-signed after LAN rotation")
	qdel(scene.node_b)
	TEST_ASSERT_EQUAL(copy.node_level(scene.node_b), NETRUN_ACCESS_NONE, "Deletion never transfers a dead node's scope to another endpoint")
